# Scout — Environment Variables
# Copy this file to .env and fill in your values

# DuckDuckGo Lite search (free, no key needed — leave blank)
# This is the default search backend used by the client-side search.
DDG_LITE_URL=https://lite.duckduckgo.com/lite/

# Optional: API keys for the server-side search with page scraping
# Uncomment and fill in if running the /api/search route locally.

# Mistral AI (free tier available at https://console.mistral.ai)
# MISTRAL_API_KEY=

# Groq (free tier available at https://console.groq.com)
# GROQ_API_KEY=

# OpenRouter (free models at https://openrouter.ai/keys)
# OPENROUTER_API_KEY=
